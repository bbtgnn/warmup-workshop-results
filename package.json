{
	"name": "warmup-results",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "tsx scripts/build-projects.ts && tsx scripts/build-subvert.ts",
		"prebuild": "tsx scripts/build-projects.ts && tsx scripts/build-subvert.ts",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"generate": "npm run prebuild",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"capture:gifs": "tsx scripts/capture-missing-gifs.ts",
		"capture:gifs:install": "playwright install chromium"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"playwright": "^1.52.0",
		"slugify": "^1.6.9",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"yaml": "^2.9.0"
	}
}
